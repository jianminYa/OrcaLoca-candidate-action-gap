# unignore a file
!requirements.txt

# Experiment/runtime outputs are intentionally kept out of Git.
output*/
log*/
.pytest_cache/
**/__pycache__/
*.egg-info/
artifacts/**/.supervisor_state
artifacts/**/supervisor*.log
artifacts/**/supervise_*.sh

# The Common93 runtime-log archive is intentionally versioned.  Its retry
# directories contain names matching the broad log*/ rule above.
!artifacts/common93_runtime_logs/retry_runtime_logs/log_1/
!artifacts/common93_runtime_logs/retry_runtime_logs/log_1/**
!artifacts/common93_runtime_logs/retry_runtime_logs/log_2/
!artifacts/common93_runtime_logs/retry_runtime_logs/log_2/**
!artifacts/common93_runtime_logs/run_control/
!artifacts/common93_runtime_logs/run_control/**
